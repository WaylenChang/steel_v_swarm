{"formatVersion":1,"source":{"inputs":{"tools/campaign_start_capture.mjs":"6830b32ad6a043cb07e6b8cf1f061f6baa33ac013ae133965bcd5111b2d43415"},"sourceInputs":{"public/js/prologue.js":"59aac6f70ba760e509fa33d964c0204ed58eeb15c48d7ad0d5aa35f9640e77bd","public/js/chapterScenes.js":"3597c27be6f7145148298ec737705b38594f573f2896cb9c298472b611106367","public/js/story.js":"9fe5997547a5f9857bf0bd1cf7bbb0bcf8642750c818d583c0ee7149c8e47575","tools/audit_src.mjs":"44ce722a743d7bb114af162e594f69643553ba364a806cf6bd550c75b1d41a84"}},"browser":"151.0.7922.34","scenes":[{"id":"economy_runaway","side":"SPEC","img":"assets/story/story_prologue_01_scholar.png","tag":"TEHRAN // 德黑蘭・純粹的算式","badge":"第一節","title":"經濟學的暴走","paragraphs":["這是一場誰都負擔得起的戰爭。","十五年前，一位德黑蘭的空氣動力學教授寫下一句乾淨得近乎無辜的命題：防禦的成本，必須低於攻擊。","他想用經濟學終結戰爭——如果一枚攻擊比它摧毀的目標更便宜，理性的國家就不會再輕啟戰端。","他錯得很徹底。他證明的不是「戰爭打不起」，而是「戰爭打不完」：當一架能擊沉坦克的自殺無人機只要四百八十美元，殺戮就成了全世界最廉價的商品，人人買得起，於是人人都在買。"],"camera":{"landscape":{"start":{"scale":1.18,"x":-6,"y":-6},"mid":{"scale":1.12,"x":0,"y":-8},"end":{"scale":1.05,"x":4,"y":-4}},"portrait":{"start":{"scale":1.25,"x":-4,"y":-10},"mid":{"scale":1.18,"x":0,"y":-8},"end":{"scale":1.1,"x":2,"y":-6}}}},{"id":"swarm_requiem","side":"SWARM","img":"assets/story/story_prologue_02_swarm.png","tag":"MARIUPOL, 2022 // 馬里烏波爾・無人機的琴弦","badge":"第二節","title":"蜂群的鎮魂曲","paragraphs":["烏克蘭的天空最先黑成一片。成群結隊、以千計數的廉價無人機像蜂群一樣撲向鋼鐵的軍隊，一種新的信仰隨之誕生——蜂群主義，「死的是機器，不是人。」","把人從危險裡撤出來，躲在螢幕後面遙控，讓便宜的、可拋棄的機器去死。","同盟由此集結：一群工程師、電競選手、音樂老師、退役感測官，用車庫改裝的六旋翼與跳頻晶片，把「用數量淹沒質量」寫成了整個時代的戰術。","他們的旗幟是一位在馬里烏波爾失去弟弟的指揮官，她把六十架蜂群指揮得像一支管弦樂團，卻拒絕替任何一架機器取名：「哀悼留給人。機器，我們再印一台。」"],"camera":{"landscape":{"start":{"scale":1.2,"x":4,"y":-8},"mid":{"scale":1.14,"x":-4,"y":-10},"end":{"scale":1.06,"x":-8,"y":-6}},"portrait":{"start":{"scale":1.25,"x":4,"y":-12},"mid":{"scale":1.18,"x":0,"y":-8},"end":{"scale":1.1,"x":-2,"y":-6}}}},{"id":"steel_epitaph","side":"STEEL","img":"assets/story/story_prologue_03_steel.png","tag":"MOSCOW, 2022 // 莫斯科近郊・四百八十美元","badge":"第三節","title":"鋼鐵的墓誌銘","paragraphs":["而在鋼鐵的那一端，一位俄羅斯上將的獨子，一名普通的機槍手，死在了一件比步槍還便宜的東西手裡。屍體旁是一台造價四百八十美元的自殺無人機殘片。","他無法接受自己人死得如此廉價。葬禮後第三天，他向總參提交重裝雙足平台的量產案，附言只有一句：","「一枚四百八十美元的無人機，換走了我一場三百萬美元也買不回的葬禮。給我的士兵穿上鋼鐵。」","協約由此成形——他們相信厚重的裝甲、相信把駕駛員包成一顆蛋的乘員艙、相信用鋼鐵的存量去換蜂群的消耗。","他們笨重、昂貴、補充有冷卻，完全違背這個時代的邏輯，可他們偏要造。裡面的人，要活著回來。"],"camera":{"landscape":{"start":{"scale":1.2,"x":-10,"y":-8},"mid":{"scale":1.14,"x":2,"y":-10},"end":{"scale":1.06,"x":-4,"y":-6}},"portrait":{"start":{"scale":1.25,"x":-8,"y":-12},"mid":{"scale":1.18,"x":2,"y":-8},"end":{"scale":1.1,"x":0,"y":-6}}}}],"programs":[{"landscape":true,"start":-3,"initial":{"active":0,"scroll":0,"targets":[{"scale":1,"x":0,"y":0},{"scale":1,"x":0,"y":0},{"scale":1,"x":0,"y":0}]},"jump":{"active":0,"scroll":0,"targets":[{"scale":1,"x":0,"y":0},{"scale":1,"x":0,"y":0},{"scale":1,"x":0,"y":0}]},"geometry":{"width":320,"height":100,"scrollHeight":260,"sections":[{"top":10,"height":200},{"top":234,"height":160},{"top":418,"height":220}]}},{"landscape":true,"start":0,"initial":{"active":0,"scroll":0,"targets":[{"scale":1,"x":0,"y":0},{"scale":1,"x":0,"y":0},{"scale":1,"x":0,"y":0}]},"jump":{"active":0,"scroll":0,"targets":[{"scale":1,"x":0,"y":0},{"scale":1,"x":0,"y":0},{"scale":1,"x":0,"y":0}]},"geometry":{"width":320,"height":100,"scrollHeight":260,"sections":[{"top":10,"height":200},{"top":234,"height":160},{"top":418,"height":220}]}},{"landscape":true,"start":1,"initial":{"active":1,"scroll":0,"targets":[{"scale":1,"x":0,"y":0},{"scale":1,"x":0,"y":0},{"scale":1,"x":0,"y":0}]},"jump":{"active":1,"scroll":160,"targets":[{"x":2.69,"y":-2.58,"scale":1.053},{"scale":1,"x":0,"y":0},{"scale":1,"x":0,"y":0}]},"geometry":{"width":320,"height":100,"scrollHeight":260,"sections":[{"top":10,"height":200},{"top":234,"height":160},{"top":418,"height":220}]}},{"landscape":true,"start":2,"initial":{"active":2,"scroll":0,"targets":[{"scale":1,"x":0,"y":0},{"scale":1,"x":0,"y":0},{"scale":1,"x":0,"y":0}]},"jump":{"active":2,"scroll":160,"targets":[{"x":2.69,"y":-2.58,"scale":1.053},