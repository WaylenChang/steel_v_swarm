class_name NativeTouchControls
extends Control

signal command(action: String, on: bool)
signal look(change: Vector2)

const MOUSE_POINTER := -2

var state: TouchState
var preferences: ControlPreferences
var buttons: Dictionary = {}
var layout_rect := Rect2()
var movement_rect := Rect2()
var look_rect := Rect2()
var held: Dictionary = {}
var kind := "mech"
var spectating := false
var enabled := false
var view_lock_active := false
var map_near := false
var badges: Dictionary = {}
var mirrors: Dictionary = {}
var rotate_hint: PanelContainer
var rotate_timer: Timer
var rotate_shown := false

func configure(settings: ControlPreferences) -> void:
	preferences = settings
	mouse_filter = Control.MOUSE_FILTER_IGNORE
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	state = TouchState.new(preferences.rules.look)
	state.command.connect(func(action, on):
		if action in ["fire", "jump", "dive", "sprint", "lock"]:
			held[action] = on
		command.emit(action, on))
	state.look.connect(func(change): look.emit(change))
	state.haptic.connect(func(milliseconds):
		if preferences.values.haptic:
			Input.vibrate_handheld(milliseconds))
	for definition: Dictionary in preferences.rules.buttons:
		var button := Button.new()
		button.text = definition.label
		button.mouse_filter = Control.MOUSE_FILTER_IGNORE
		button.focus_mode = Control.FOCUS_NONE
		button.add_theme_font_size_override("font_size", 16)
		button.modulate.a = 0.75
		add_child(button)
		buttons[definition.action] = button
	for action: String in ["def", "atk", "jump", "special"]:
		var badge := Label.new()
		badge.mouse_filter = Control.MOUSE_FILTER_IGNORE
		badge.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		badge.add_theme_font_size_override("font_size", 11)
		badge.add_theme_color_override("font_color", Color(preferences.rules.touchHud.danger))
		buttons[action].add_child(badge)
		badges[action] = badge
	rotate_hint = NativeUi.panel(Vector2.ZERO)
	rotate_hint.set_anchors_and_offsets_preset(Control.PRESET_TOP_LEFT)
	rotate_hint.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var rotate_text := NativeUi.label(preferences.rules.touchHud.rotateText, 11)
	rotate_text.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	rotate_text.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	rotate_hint.add_child(rotate_text)
	rotate_hint.hide()
	add_child(rotate_hint)
	rotate_timer = Timer.new()
	rotate_timer.one_shot = true
	rotate_timer.ignore_time_scale = true
	rotate_timer.process_mode = Node.PROCESS_MODE_ALWAYS
	rotate_timer.wait_time = preferences.rules.touchHud.rotateSeconds
	rotate_timer.timeout.connect(func(): rotate_hint.hide())
	add_child(rotate_timer)
	for action: String in ["lock", "swap"]:
		buttons[action].disabled = action == "swap" or not Content.balance.has("view")
		buttons[action].tooltip_text = Content.label(("touch_lock_pending" if buttons[action].disabled else "view_lock_hint") if action == "lock" else "touch_squad_single")
	preferences.changed.connect(_preferences_changed)
	resized.connect(_layout)
	_preferences_changed()

func _preferences_changed() -> void:
	state.sensitivity = preferences.values.lookSens
	reset()
	_layout()
	sync(enabled, state.blocked)

func sync(in_battle: bool, blocked: bool) -> void:
	enabled = in_battle
	var shown := enabled and preferences.scheme() == "pad" and not blocked
	state.set_blocked(not shown)
	visible = shown
	if shown:
		_update_rotate_hint(size.y >= size.x)

func begin_match() -> void:
	set_spectating(false)
	rotate_shown = false
	rotate_timer.stop()
	rotate_hint.hide()
	mirrors.clear()
	for badge: Label in badges.values():
		badge.text = ""
	_layout()

static func mirror_state(cd: float, ready: bool, locked: bool, charges: String = "") -> Dictionary:
	return {"text": "%ds" % int(CssDecimal.fixed(cd, 0)) if cd > float(Content.balance.mobile.touchHud.cooldownThreshold) else charges,
		"ready": ready, "locked": locked}

func mirror(action: String, cd: float, ready: bool, locked: bool, charges: String = "") -> void:
	if not badges.has(action):
		return
	var result := mirror_state(cd, ready, locked, charges)
	mirrors[action] = result
	badges[action].text = result.text

func reset() -> void:
	if state == null:
		return
	state.reset()
	# The source overlay also clears its keyboard state. Native touch owns a
	# separate held account, including sprint generated by the movement stick.
	held.clear()
	queue_redraw()

func set_kind(value: String) -> void:
	if kind == value:
		return
	kind = value
	_apply_kind()

func set_spectating(on: bool) -> void:
	spectating = on
	_apply_kind()

func _apply_kind() -> void:
	if not preferences.rules.has("kindPresentation"):
		return
	var plan: Dictionary = preferences.rules.kindPresentation.get("" if spectating else kind, preferences.rules.kindPresentation.mech)
	buttons.jump.text = plan.jump
	buttons.special.text = plan.special
	buttons.swap.text = plan.swap
	for action: String in plan.hidden:
		buttons[action].visible = not plan.hidden[action]
	buttons.swap.disabled = not spectating
	buttons.swap.tooltip_text = "" if spectating else Content.label("touch_squad_single")
	for action: String in ["def", "atk", "jump", "special"]:
		if spectating:
			badges[action].text = ""

func set_gyro_status(key: String) -> void:
	buttons.gyro.tooltip_text = Content.label(key)
	queue_redraw()

func set_view_lock(on: bool) -> void:
	if view_lock_active != on:
		view_lock_active = on
		queue_redraw()

func set_map_near(on: bool) -> void:
	if map_near != on:
		map_near = on
		queue_redraw()

func show_civilian(on: bool) -> void:
	buttons.civ_follow.visible = on
	buttons.civ_away.visible = on

func _layout() -> void:
	if state == null or size.x <= 0 or size.y <= 0:
		return
	reset()
	layout_rect = NativeUi.safe_area(self)
	var space := layout_rect.size
	var radius := minf(space.x * 0.09, space.y * 0.16)
	var left := Vector2(radius + 92, space.y * 0.43)
	var right := Vector2(space.x - left.x, space.y * 0.75)
	movement_rect = Rect2(layout_rect.position + left - Vector2.ONE * radius, Vector2.ONE * radius * 2)
	look_rect = Rect2(layout_rect.position + right - Vector2.ONE * radius, Vector2.ONE * radius * 2)
	var unit := minf(radius * 0.72, space.y * 0.085)
	var dpad := Vector2(left.x, right.y)
	var face := Vector2(right.x, left.y)
	var placements := {"shop": dpad + Vector2(0, -unit), "map": dpad + Vector2(unit, 0),
		"gyro": dpad + Vector2(0, unit), "special": dpad + Vector2(-unit, 0),
		"def": face + Vector2(-unit, 0), "atk": face + Vector2(0, -unit),
		"fire": face + Vector2(unit, 0), "jump": face + Vector2(0, unit)}
	for action: String in placements:
		_place(action, placements[action], Vector2.ONE * unit * 0.95)
	for column: int in range(2):
		var actions := ["reload", "dive", "menu"] if column == 0 else ["aim", "lock", "swap", "lefty"]
		for row: int in range(actions.size()):
			_place(actions[row], Vector2(43 if column == 0 else space.x - 43, space.y * 0.35 + row * 49), Vector2(78, 44))
	_place("civ_follow", Vector2(space.x / 2 - 60, space.y - 42), Vector2(112, 44))
	_place("civ_away", Vector2(space.x / 2 + 60, space.y - 42), Vector2(112, 44))
	if preferences.values.lefty:
		movement_rect.position.x = layout_rect.position.x + layout_rect.end.x - movement_rect.end.x
		look_rect.position.x = layout_rect.position.x + layout_rect.end.x - look_rect.end.x
	for action: String in ["civ_follow", "civ_away"]:
		buttons[action].visible = false
	var current_kind := kind
	kind = ""
	set_kind(current_kind)
	for action: String in badges:
		var badge: Label = badges[action]
		badge.position = Vector2(0, buttons[action].size.y * 0.66)
		badge.size = Vector2(buttons[action].size.x, buttons[action].size.y * 0.33)
	rotate_hint.position = layout_rect.position + Vector2(space.x * 0.06, space.y * 0.4)
	rotate_hint.size = Vector2(space.x * 0.88, 60)
	_update_rotate_hint(size.y >= size.x, true)
	queue_redraw()

func _update_rotate_hint(portrait: bool, resized_hint: bool = false) -> void:
	if not portrait or resized_hint and rotate_shown:
		rotate_hint.hide()
	elif enabled and not rotate_shown:
		rotate_shown = true
		rotate_hint.show()
		rotate_timer.start()

func _place(action: String, centre: Vector2, dimensions: Vector2) -> void:
	if preferences.values.lefty:
		centre.x = layout_rect.size.x - centre.x
	var button: Button = buttons[action]
	button.position = layout_rect.position + centre - dimensions / 2
	button.size = dimensions

func _down(id: int, point: Vector2, now: float) -> void:
	if rotate_hint.visible and Rect2(rotate_hint.position, rotate_hint.size).has_point(point):
		rotate_hint.hide()
		return
	for action: String in buttons:
		var button: Button = buttons[action]
		if button.visible and Rect2(button.position, button.size).has_point(point):
			if not button.disabled:
				state.button_down(action, id, point, now)
			else:
				command.emit("unavailable_" + action, true)
			return
	if movement_rect.has_point(point):
		state.stick_down(true, id, point, movement_rect.get_center(), movement_rect.size.x / 2)
	elif look_rect.has_point(point):
		state.stick_down(false, id, point, look_rect.get_center(), look_rect.size.x / 2)
	else:
		state.look_down(id, point, now)

func _input(event: InputEvent) -> void:
	if not visible or state == null:
		return
	var now := float(Time.get_ticks_msec())
	if event is InputEventScreenTouch:
		var point: Vector2 = get_global_transform_with_canvas().affine_inverse() * event.position
		if event.pressed:
			_down(event.index, point, now)
		else:
			state.up(event.index, point, now, event.canceled)
	elif event is InputEventScreenDrag:
		state.move(event.index, get_global_transform_with_canvas().affine_inverse() * event.position)
	elif event is InputEventMouseButton and event.device != InputEvent.DEVICE_ID_EMULATION and event.button_index == MOUSE_BUTTON_LEFT:
		var point: Vector2 = get_global_transform_with_canvas().affine_inverse() * event.position
		if event.pressed:
			_down(MOUSE_POINTER, point, now)
		else:
			state.up(MOUSE_POINTER, point, now)
	elif event is InputEventMouseMotion and state.owns(MOUSE_POINTER):
		state.move(MOUSE_POINTER, get_global_transform_with_canvas().affine_inverse() * event.position)
	else:
		return
	get_viewport().set_input_as_handled()
	queue_redraw()

func tick(delta: float) -> void:
	if visible:
		state.tick(delta, Time.get_ticks_msec())
		queue_redraw()

func _draw() -> void:
	if state == null:
		return
	for index: int in range(2):
		var rect := movement_rect if index == 0 else look_rect
		var stick: Dictionary = state.move_stick if index == 0 else state.look_stick
		var vector: Vector2 = stick.vector
		draw_circle(rect.get_center(), rect.size.x / 2, Color(0.04, 0.1, 0.16, 0.4))
		draw_arc(rect.get_center(), rect.size.x / 2, 0, TAU, 64, Color(0.45, 0.8, 1, 0.55), 2, true)
		draw_circle(rect.get_center() + Vector2(vector.x, -vector.y) * rect.size.x * 0.21, rect.size.x * 0.17, Color(0.5, 0.85, 1, 0.6))
	for action: String in buttons:
		var pressed := action in state.held.values() or state.taps.values().any(func(tap): return tap.action == action)
		var on := action == "lefty" and bool(preferences.values.lefty) or action == "gyro" and bool(preferences.values.gyro) and NativeGyro.supported() or action == "lock" and view_lock_active or action == "map" and map_near
		buttons[action].modulate = Color(0.5, 0.9, 1, 1) if on else Color(1, 1, 1, 1 if pressed else 0.75)
		var result: Dictionary = mirrors.get(action, {})
		if not result.is_empty():
			buttons[action].add_theme_color_override("font_color", Color(preferences.rules.touchHud.ok) if result.ready else Color.WHITE)
			if result.locked:
				buttons[action].modulate.a = 0.375

func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_FOCUS_OUT:
		reset()

func _exit_tree() -> void:
	reset()
