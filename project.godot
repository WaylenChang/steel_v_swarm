; Native Godot project; game runtime requires no Node.js or browser.
config_version=5

[application]
config/name="Steel vs. Swarm"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
Content="*res://scripts/content.gd"
Controls="*res://scripts/control_preferences.gd"
Session="*res://scripts/session.gd"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[input_devices]
sensors/enable_gravity=true
sensors/enable_gyroscope=true
sensors/enable_magnetometer=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

